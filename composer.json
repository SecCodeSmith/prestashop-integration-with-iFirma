{
    "name": "seccodesmith/ifirma-prestashop",
    "description": "iFirma receipts and invoices for PrestaShop (development tooling only).",
    "type": "prestashop-module",
    "license": "proprietary",
    "require": {
        "php": ">=7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true,
        "vendor-dir": "tests/vendor"
    },
    "scripts": {
        "test": "tests/vendor/bin/phpunit",
        "coverage": "tests/vendor/bin/phpunit --coverage-cobertura build/coverage.xml"
    }
}
